# Sanitized examples only. Do not copy credentials from the production .env.
# For local development, copy this example to ignored .env.local and fill
# the blank local-only secrets. Never commit the resulting file.
# Select settings explicitly in the shell or with manage.py --settings.
DJANGO_SETTINGS_MODULE=alx_project_nexus.settings_local
NEXUS_LOCAL_SECRET_KEY=
NEXUS_LOCAL_DB_HOST=127.0.0.1
NEXUS_LOCAL_DB_PORT=55432
NEXUS_LOCAL_DB_NAME=nexus_local_dev
NEXUS_LOCAL_DB_USER=nexus_local_user
NEXUS_LOCAL_DB_PASSWORD=
NEXUS_LOCAL_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Reserved React development origin. No React application exists yet.
NEXUS_LOCAL_CORS_ALLOWED_ORIGINS=http://localhost:5173
NEXUS_LOCAL_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Tests use a separately approved disposable PostgreSQL instance.
# settings_test NEVER loads this file or .env.local. Export NEXUS_TEST_*
# variables explicitly; pytest.ini selects settings_test automatically.
# Choose DJANGO_SETTINGS_MODULE=alx_project_nexus.settings_test for other
# test commands. Never supply POSTGRES_* production values as substitutes.
NEXUS_TEST_SECRET_KEY=
NEXUS_TEST_DB_HOST=127.0.0.1
NEXUS_TEST_DB_PORT=55433
NEXUS_TEST_DB_NAME=nexus_test_dev
NEXUS_TEST_DB_USER=nexus_test_user
NEXUS_TEST_DB_PASSWORD=
