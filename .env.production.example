# Sanitized operator template, NEVER an automatically loaded configuration.
# Copy only into an approved secret store or ignored .env.production.
# The application still uses the existing production settings entry point.
DJANGO_SETTINGS_MODULE=alx_project_nexus.settings
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
# Required: direct (backend terminates TLS), or trusted (restricted TLS proxy).
DJANGO_PROXY_MODE=
# Set true only after the proxy strips client protocol headers and overwrites
# X-Forwarded-Proto; backend must not be reachable by untrusted clients.
DJANGO_PROXY_HEADERS_STRIPPED=false
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# Keep zero until HTTPS/proxy testing and operator approval, then stage HSTS.
# Deployment preflight intentionally blocks zero HSTS; never preload blindly.
DJANGO_HSTS_SECONDS=0
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=
# Never change these as part of ordinary deployment/CI.
NEXUS_BALLOT_AUTHORITY=bridge
NEXUS_BALLOT_WRITES_ENABLED=false
# Recovery requires BOTH flags plus trusted origin and verified SMTP setup.
NEXUS_PASSWORD_RESET_ENABLED=false
NEXUS_PASSWORD_RESET_APPROVED=false
NEXUS_PASSWORD_RESET_FRONTEND_ORIGIN=
NEXUS_EMAIL_HOST=
NEXUS_EMAIL_PORT=587
NEXUS_EMAIL_SECURITY=starttls
NEXUS_EMAIL_TIMEOUT=10
NEXUS_EMAIL_HOST_USER=
NEXUS_EMAIL_HOST_PASSWORD=
NEXUS_DEFAULT_FROM_EMAIL=
