# Provider-independent, opt-in artifact. No migration or backfill at startup.
FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=alx_project_nexus.settings \
    NEXUS_SERVE_FRONTEND=true
WORKDIR /app
COPY requirements.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --timeout 120 --retries 5 -r requirements.txt
COPY accounts/ accounts/
COPY polls/ polls/
COPY alx_project_nexus/ alx_project_nexus/
COPY scripts/ scripts/
COPY manage.py gunicorn.conf.py ./
COPY --from=frontend /build/dist/ frontend/dist/
# Offline synthetic configuration; no real environment, network or database.
RUN python -B scripts/prepare_static.py
RUN useradd --uid 10001 --create-home nexus
USER 10001:10001
EXPOSE 8000
CMD ["gunicorn", "-c", "gunicorn.conf.py", "alx_project_nexus.wsgi:application"]
